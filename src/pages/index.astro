---
import Layout from '../components/Layout.astro';
import GameCard from '../components/GameCard.astro';
import { games } from '../data/games';

const features = [
  {
    icon: '01',
    title: '100% en la web',
    text: 'Cada juego corre directo en tu navegador, en cualquier dispositivo. No instalás nada.',
  },
  {
    icon: '02',
    title: 'Todos los géneros',
    text: 'Estrategia, arcade, puzles, aventura… una colección de juegos de todo tipo que no para de crecer.',
  },
  {
    icon: '03',
    title: 'Un clic y a jugar',
    text: 'Sin filas, sin cuentas raras, sin fricción. Entrás, elegís y ya estás dentro.',
  },
];

const genres = ['Estrategia', 'En tu navegador', 'Sin descargas', 'Para explorar'];
const featured = games.find((game) => game.slug === 'strategy-game-world' && game.status === 'available');
---

<Layout
  title="DevCito Games — Juegos de todo tipo en tu navegador"
  description="DevCito Games: juegos de todo tipo en plataforma web. Estrategia, arcade, puzles y más, gratis y directo en tu navegador."
>
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="stars stars-a" aria-hidden="true"></div>
      <div class="stars stars-b" aria-hidden="true"></div>
      <div class="orb orb-a" aria-hidden="true"></div>
      <div class="orb orb-b" aria-hidden="true"></div>

      <div class="hero-shell">
        <div class="hero-content">
          <p class="hero-kicker" data-reveal>Tu próxima aventura empieza aquí</p>
          <h1 class="hero-title" data-reveal style="--reveal-delay: 0.08s">
            Un mundo para <span class="hero-accent">jugar.</span>
          </h1>
          <p class="hero-subtitle" data-reveal style="--reveal-delay: 0.16s">
            Estrategia, nuevos desafíos y grandes aventuras. Directo en tu navegador, sin descargas y a tu ritmo.
          </p>
          <div class="hero-actions" data-reveal style="--reveal-delay: 0.24s">
            <a href="#juegos" class="btn btn-primary">Explorar juegos <span aria-hidden="true">↗</span></a>
            <a href="https://devcito.org" target="_blank" rel="noopener" class="btn btn-ghost">
              Conocé DevCito
            </a>
          </div>
          <p class="hero-note" data-reveal>GRATIS PARA JUGAR <span>✦</span> DESDE CUALQUIER LUGAR</p>
        </div>
        {featured && (
          <a class="featured" href={`/juegos/${featured.slug}`} data-reveal style="--reveal-delay: 0.15s" aria-label={`Jugar ${featured.title}`}>
            <div class="featured-top"><span>EN DESTACADO</span><span>LISTO PARA JUGAR</span></div>
            <div class="planet-scene" aria-hidden="true">
              <span class="orbit orbit-one"></span><span class="orbit orbit-two"></span>
              <span class="planet"><span class="land land-west"></span><span class="land land-east"></span><span class="land land-south"></span></span>
              <span class="planet-pin pin-one"></span><span class="planet-pin pin-two"></span>
              <span class="planet-caption">UN MUNDO POR CONQUISTAR</span>
            </div>
            <div class="featured-bottom">
              <div><span class="featured-genre">{featured.genre}</span><strong>{featured.title}</strong></div>
              <span class="featured-arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        )}
      </div>

      <!-- Genre marquee -->
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          <span class="marquee-group">
            {genres.map((g) => <em>{g}</em>)}
          </span>
          <span class="marquee-group">
            {genres.map((g) => <em>{g}</em>)}
          </span>
        </div>
      </div>
    </section>

    <!-- Games -->
    <section id="juegos" class="games-section">
      <div class="section-head" data-reveal>
        <p class="section-kicker">ELIGE TU AVENTURA</p>
        <h2>Tu próxima partida.</h2>
        <p>Explora los juegos disponibles y entra directo a la acción.</p>
      </div>
      <div class="games-grid">
        {games.map((game, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 0.12}s`}>
            <GameCard game={game} />
          </div>
        ))}
      </div>
    </section>

    <section class="features" aria-label="Cómo jugar">
      {features.map((f, i) => (
        <article class="feature" data-reveal style={`--reveal-delay: ${i * 0.12}s`}>
          <span class="feature-icon">{f.icon}</span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </article>
      ))}
    </section>
  </main>

  <script>
    if ('IntersectionObserver' in window) {
      document.documentElement.classList.add('js-reveal');
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      targets.forEach((el) => io.observe(el));
    }
  </script>
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 6.5rem 1.5rem 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 56rem;
    margin: 0 auto;
    padding-bottom: 4.5rem;
  }

  /* starfield: two tiled dot layers drifting at different speeds */
  .stars {
    position: absolute;
    inset: -50%;
    background-repeat: repeat;
    pointer-events: none;
  }

  .stars-a {
    background-image:
      radial-gradient(1px 1px at 22px 34px, rgba(226, 232, 240, 0.9), transparent),
      radial-gradient(1px 1px at 78px 92px, rgba(125, 211, 252, 0.8), transparent),
      radial-gradient(1.5px 1.5px at 130px 55px, rgba(226, 232, 240, 0.7), transparent),
      radial-gradient(1px 1px at 165px 120px, rgba(167, 139, 250, 0.8), transparent),
      radial-gradient(1px 1px at 45px 150px, rgba(226, 232, 240, 0.6), transparent);
    background-size: 190px 190px;
    animation: drift-a 90s linear infinite, twinkle 5s ease-in-out infinite;
  }

  .stars-b {
    background-image:
      radial-gradient(1.5px 1.5px at 60px 20px, rgba(125, 211, 252, 0.9), transparent),
      radial-gradient(1px 1px at 120px 80px, rgba(226, 232, 240, 0.7), transparent),
      radial-gradient(2px 2px at 30px 110px, rgba(167, 139, 250, 0.75), transparent),
      radial-gradient(1px 1px at 150px 140px, rgba(226, 232, 240, 0.8), transparent);
    background-size: 240px 240px;
    animation: drift-b 140s linear infinite, twinkle 7s ease-in-out infinite reverse;
  }

  @keyframes drift-a {
    to { transform: translate3d(-120px, 90px, 0); }
  }

  @keyframes drift-b {
    to { transform: translate3d(140px, -110px, 0); }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0.4; }
  }

  /* floating glow orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
    animation: float 12s ease-in-out infinite;
  }

  .orb-a {
    width: 340px;
    height: 340px;
    left: -6%;
    top: 12%;
    background: rgba(56, 189, 248, 0.16);
  }

  .orb-b {
    width: 300px;
    height: 300px;
    right: -4%;
    top: 34%;
    background: rgba(167, 139, 250, 0.16);
    animation-delay: -6s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-34px) scale(1.08); }
  }

  .hero-kicker {
    display: inline-block;
    padding: 0.38rem 1rem;
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 999px;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.06);
    margin-bottom: 2rem;
  }

  .hero-title {
    font-size: clamp(3rem, 9vw, 6.2rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 1.6rem;
  }

  .hero-accent {
    display: block;
    background: linear-gradient(90deg, #38bdf8, #a78bfa, #22d3ee, #38bdf8);
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 6s linear infinite;
  }

  @keyframes shine {
    to { background-position: 300% center; }
  }

  .hero-subtitle {
    max-width: 44rem;
    margin: 0 auto 2.6rem;
    font-size: 1.2rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ---------- Marquee ---------- */
  .marquee {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.85rem 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.015);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 26s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
  }

  .marquee-group em {
    font-style: normal;
    padding: 0 1.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .marquee-group em::after {
    content: '◆';
    margin-left: 3.2rem;
    font-size: 0.55rem;
    color: var(--accent-violet);
    vertical-align: middle;
  }

  @keyframes scroll {
    to { transform: translateX(-50%); }
  }

  /* ---------- Features ---------- */
  .features {
    max-width: 1080px;
    margin: 0 auto;
    padding: 5rem 1.5rem 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.4rem;
  }

  .feature {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-card);
    padding: 1.8rem 1.6rem;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .feature:hover {
    border-color: rgba(167, 139, 250, 0.5);
    transform: translateY(-3px);
  }

  .feature-icon {
    display: inline-block;
    font-size: 1.9rem;
    margin-bottom: 0.9rem;
    animation: bob 3.2s ease-in-out infinite;
  }

  .feature:nth-child(2) .feature-icon { animation-delay: -1s; }
  .feature:nth-child(3) .feature-icon { animation-delay: -2s; }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .feature h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }

  .feature p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ---------- Games ---------- */
  .games-section {
    padding: 3.5rem 1.5rem 7rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .section-head {
    margin-bottom: 2.5rem;
  }

  .section-head h2 {
    font-size: 2.2rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .section-head p {
    color: var(--text-muted);
    margin: 0;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.6rem;
  }

  .games-grid > div {
    height: 100%;
  }

  .hero {
    text-align: left;
    padding: 5rem 1.5rem 0;
    background: linear-gradient(180deg, rgba(20, 45, 59, 0.3), transparent 85%);
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding-bottom: 5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.88fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
  }

  .hero-content { margin: 0; padding: 0; }
  .hero-kicker {
    padding: 0;
    margin: 0 0 1.5rem;
    border: 0;
    background: none;
    color: #e8c278;
    font-size: 0.73rem;
    font-weight: 700;
  }
  .hero-kicker::before { content: '✦'; margin-right: 0.65rem; }
  .hero-title {
    max-width: 10ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3.2rem, 6vw, 5.6rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
  }
  .hero-accent {
    display: inline;
    background: linear-gradient(100deg, #7be1d2, #6cc9ed);
    -webkit-background-clip: text;
    background-clip: text;
    animation: none;
  }
  .hero-subtitle { margin: 0 0 2rem; max-width: 32rem; font-size: 1.05rem; line-height: 1.7; }
  .hero-actions { justify-content: flex-start; }
  .hero-note { margin: 2rem 0 0; color: #7f9ba3; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; }
  .hero-note span { padding: 0 0.5rem; color: #e8c278; }

  .featured {
    display: block;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(146, 205, 200, 0.24);
    border-radius: 22px;
    background: #0c202a;
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.34);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .featured:hover { transform: translateY(-5px); border-color: rgba(130, 224, 211, 0.65); }
  .featured:focus-visible { outline: 3px solid #8ce5dc; outline-offset: 4px; }
  .featured-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    color: #a7c7c7;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .featured-top span:first-child { color: #e8c278; }
  .planet-scene {
    position: relative;
    display: grid;
    place-items: center;
    height: 225px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgba(80, 190, 177, 0.25), transparent 62%),
      linear-gradient(rgba(141, 215, 203, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(141, 215, 203, 0.07) 1px, transparent 1px),
      #0a1a28;
    background-size: auto, 32px 32px, 32px 32px, auto;
  }
  .planet {
    position: absolute;
    width: 150px;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 32% 28%, #4f9e9c, #1d5e75 58%, #0c2c45);
    box-shadow: inset -18px -14px 30px rgba(4, 17, 30, 0.55), 0 0 50px rgba(68, 185, 171, 0.25);
  }
  .land { position: absolute; background: linear-gradient(140deg, #a5e5c9, #4d9f96); opacity: 0.85; }
  .land-west { left: 7%; top: 20%; width: 43%; height: 45%; clip-path: polygon(3% 12%, 35% 0, 62% 8%, 100% 20%, 77% 42%, 62% 47%, 68% 66%, 48% 71%, 42% 100%, 22% 69%, 26% 50%, 0 38%); }
  .land-east { left: 48%; top: 19%; width: 48%; height: 50%; clip-path: polygon(4% 19%, 21% 5%, 53% 0, 95% 16%, 100% 38%, 75% 47%, 63% 41%, 52% 62%, 32% 58%, 22% 100%, 5% 75%, 18% 49%, 0 40%); }
  .land-south { left: 68%; top: 73%; width: 22%; height: 14%; clip-path: polygon(4% 32%, 34% 0, 84% 12%, 100% 58%, 63% 100%, 12% 79%); }
  .orbit { position: absolute; width: 235px; height: 120px; border: 1px solid rgba(201, 231, 210, 0.32); border-radius: 50%; transform: rotate(-24deg); }
  .orbit-two { width: 195px; height: 205px; transform: rotate(38deg); opacity: 0.45; }
  .planet-pin { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: #f0c77b; box-shadow: 0 0 0 5px rgba(240, 199, 123, 0.15), 0 0 16px #f0c77b; }
  .pin-one { transform: translate(-45px, -38px); }
  .pin-two { transform: translate(51px, 21px); }
  .planet-caption { position: absolute; left: 1rem; bottom: 1rem; color: #9dc7c2; font-size: 0.57rem; font-weight: 700; letter-spacing: 0.15em; }
  .featured-bottom { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.2rem 1.3rem; }
  .featured-bottom strong { display: block; margin-top: 0.35rem; font-size: 1rem; }
  .featured-genre { color: #a3c8c3; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .featured-arrow { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid #6cafa7; border-radius: 50%; color: #9ce7d7; font-size: 1.15rem; }

  .games-section { padding: 5rem 1.5rem 1rem; scroll-margin-top: 5rem; }
  .section-head h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .section-head .section-kicker { color: #d7bb7f; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; margin-bottom: 0.7rem; }
  .games-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .features { padding: 3rem 1.5rem 6rem; }
  .feature { background: linear-gradient(140deg, rgba(40, 73, 78, 0.3), rgba(11, 20, 33, 0.8)); }
  .feature-icon { color: #8cdbce; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; animation: none; }

  @media (max-width: 720px) {
    .hero { padding-top: 3rem; }
    .hero-shell { grid-template-columns: 1fr; gap: 2.5rem; padding-bottom: 3.5rem; }
    .hero-title { font-size: clamp(3rem, 12vw, 4.5rem); }
    .hero-subtitle { font-size: 1rem; }
    .featured { max-width: 480px; width: 100%; }
    .planet-scene { height: 190px; }
    .games-section { padding-top: 3.5rem; }
  }
</style>
